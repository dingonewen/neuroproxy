# Model configuration for natural-language analysis and context recovery.
NEUROPROXY_MODEL=
ANTHROPIC_API_KEY=

# Photon 2.0 Beta read-only connection check.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# Webhook destination signing secret (not the API key).
PHOTON_WEBHOOK_SECRET=
# Your active Photon SMS number in E.164 format (for example, +1 followed by 10 digits).
PHOTON_SMS_NUMBER=

# Separate random secret for the voice provider's webhook tool (32+ characters).
VOICE_TOOL_SECRET=

# ElevenLabs onboarding stores ELEVENLABS_API_KEY in ignored .env.local.
ELEVENLABS_AGENT_ID=

# Optional exact hostname for a Cloudflare Access-protected mobile web app.
# Never expose the web app or API publicly without access controls.
NEUROPROXY_WEB_HOST=

# Optional Logfire tracing: metadata only, disabled when token is empty.
LOGFIRE_TOKEN=
# Optional Logfire regional base URL (HTTPS).
LOGFIRE_BASE_URL=

# Optional: Cloudflare Workers AI embeddings for reply-insight deduplication.
# Enabling sends relevant insight text to Cloudflare; empty values use local lexical matching.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
